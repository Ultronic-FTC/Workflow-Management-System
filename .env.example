NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only key. Get this from Supabase Project Settings -> API Keys -> Secret keys.
# NEVER prefix this with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SECRET_KEY=sb_secret_your-server-key

# Server-only shared code used to enter the Ultronic team workspace.
TEAM_ACCESS_CODE=choose-a-strong-shared-team-code
